# Copy to .env and change every value. Never commit .env.
# --- Supabase database (Project Settings > Database > Connection string > Session pooler, port 5432) ---
DB_URL=jdbc:postgresql://aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.YOUR-PROJECT-REF
DB_PASSWORD=change-me-supabase-db-password
# Only for the optional local docker-compose database (see README). Local example: DB_URL=jdbc:postgresql://localhost:5432/homeseek
DB_NAME=homeseek
# --- Gmail SMTP for password reset emails ---
# MAIL_USERNAME: the Gmail address that sends the emails.
# MAIL_APP_PASSWORD: a Google App Password (16 letters, paste it WITHOUT spaces). Not your normal Gmail password.
MAIL_USERNAME=your.address@gmail.com
MAIL_APP_PASSWORD=change-me-16-letter-app-password
# --- Backend ---
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# The frontend address. Also used as the base of the password reset link.
CORS_ALLOWED_ORIGIN=http://localhost:5173
# --- First Admin account (created at startup if it does not exist) ---
# Password: at least 8 characters with a letter and a number.
ADMIN_EMAIL=admin@homeseek.local
ADMIN_NAME=HomeSeek Admin
ADMIN_PASSWORD=change-me-admin-password1
