# Copy to .env and change every value. Never commit .env.
# --- PostgreSQL (used by docker-compose.yml and by the backend) ---
DB_NAME=homeseek
DB_USERNAME=homeseek
DB_PASSWORD=change-me-db-password
DB_URL=jdbc:postgresql://localhost:5432/homeseek
# --- Backend ---
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
CORS_ALLOWED_ORIGIN=http://localhost:5173
# --- First Admin account (created at startup if it does not exist) ---
# Password: at least 8 characters with a letter and a number.
ADMIN_EMAIL=admin@homeseek.local
ADMIN_NAME=HomeSeek Admin
ADMIN_PASSWORD=change-me-admin-password1
